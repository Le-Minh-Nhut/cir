# Copy to .env (same directory as docker-compose.yml) and adjust.
# Every WORKBENCH_* key matches workbench/backend/operator_config.py.

# Host ports (host side of the -p mapping).
WORKBENCH_BACKEND_PORT=8000
WORKBENCH_FRONTEND_PORT=5173

# Bind inside the container; publish through `ports`.
WORKBENCH_HOST=0.0.0.0

# Paths INSIDE the container (the compose file mounts host paths onto these).
CIR_REPO_ROOT=/repo
CIR_DATA_ROOT=/data
FASHIONIQ_ROOT=/data/FashionIQ
WORKBENCH_ARTIFACTS_ROOT=/artifacts
WORKBENCH_CHECKPOINT_ROOT=/checkpoints
WORKBENCH_RESULTS_ROOT=/results
WORKBENCH_THIRD_PARTY_ROOT=/third_party

# Host paths the compose file mounts into the container. Relative values are resolved from
# THIS directory (workbench/docker), so the checked-in defaults point at the repository's own
# data/ and workbench/ trees. Use absolute paths to keep the datasets on another disk.
HOST_FASHIONIQ_ROOT=../../data/FashionIQ
HOST_WORKBENCH_THIRD_PARTY_ROOT=../../workbench/third_party
HOST_WORKBENCH_CHECKPOINT_ROOT=../../workbench/artifacts/checkpoints
HOST_WORKBENCH_ARTIFACTS_ROOT=../../workbench/artifacts
HOST_WORKBENCH_RESULTS_ROOT=../../workbench/artifacts/results

# Dataset root the pipeline preparation stage is pointed at inside the container.
WORKBENCH_DATASET_ROOT=/data/FashionIQ

# Set to 1 ONLY after nvidia-container-toolkit is installed on the host; run.sh then adds the
# docker-compose.gpu.yml override, which requests all NVIDIA GPUs (fail closed: without the
# toolkit the container refuses to start rather than silently dropping the GPU).
# WORKBENCH_ENABLE_GPU=1

# Optional: operator-selected runtime adaptation for Blackwell (sm_120).
# Set only for models whose registry entry declares this adapted_runtime.
# WORKBENCH_RUNTIME_ADAPTATION=sm_120
