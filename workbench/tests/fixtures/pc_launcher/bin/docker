#!/usr/bin/env python3
import sys
import os
import json

log_file = os.environ.get("MOCK_LOG_FILE")
if log_file:
    try:
        secrets = {
            k: v for k, v in os.environ.items()
            if any(p in k for p in ("TOKEN", "KEY", "SECRET", "LEDGER"))
        }
        with open(log_file, "a") as f:
            f.write(json.dumps({"tool": "docker", "args": sys.argv[1:], "secrets": secrets}) + "\n")
    except Exception:
        pass

args_str = " ".join(sys.argv)

# `run.sh up` is idempotent: when the project is already running, compose recreates nothing, so
# the effective configuration is unchanged by the call. That is exactly the case the launcher's
# post-restart re-inspection exists for, so it has to be expressible here: `MOCK_DOCKER_MOUNTS`
# and `MOCK_CONTAINER_ADAPTATION` are the configuration in effect, and the `..._REFRESHED`
# variants replace them once the container has actually been recreated. A generation counter
# keeps the two apart and works for several corrected containers in one process.
def _generation_dir():
    return os.path.join(os.environ.get("CIR_REPO_ROOT", ""), "mock_docker_gen")

def _generation():
    try:
        return int(open(os.path.join(_generation_dir(), "count")).read().strip() or "0")
    except Exception:
        return 0

def _label():
    """The commit the running image was built from, as `run.sh up` stamps it.

    `pc.sh` reuses a live container on a configuration match, and configuration says nothing about
    which commit was baked into the image: after a `git pull` the old image's backend, queue,
    verifier and evaluator would sign a report naming the new commit. The launcher therefore asks
    the container, and the default here is the harness's own git shim value -- so "same checkout"
    is the default state and a test changes `MOCK_IMAGE_COMMIT` to express a stale image.
    """
    label = os.environ.get("MOCK_IMAGE_COMMIT", "0123456789abcdef0123456789abcdef01234567")
    if _generation() > 0 and os.environ.get("MOCK_IMAGE_COMMIT_REFRESHED") is not None:
        label = os.environ["MOCK_IMAGE_COMMIT_REFRESHED"]
    return label

def _bump_generation():
    try:
        os.makedirs(_generation_dir(), exist_ok=True)
        with open(os.path.join(_generation_dir(), "count"), "w") as handle:
            handle.write(str(_generation() + 1))
    except OSError:
        pass

if "version" in sys.argv:
    if os.environ.get("MOCK_DOCKER_NO_DAEMON") == "1" or os.environ.get("MOCK_DOCKER_FAIL_VERSION") == "1":
        sys.stderr.write("Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?\n")
        sys.exit(1)
    if any("--format" in a for a in sys.argv):
        print("24.0.5")
    else:
        print("Docker version 24.0.5, build ced0996")
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == "compose":
    if "version" in sys.argv:
        if "--short" in sys.argv:
            print("v2.20.2")
        else:
            print("Docker Compose version v2.20.2")
        sys.exit(0)
    if "up" in sys.argv:
        if os.environ.get("MOCK_DOCKER_FAIL_UP") == "1":
            sys.stderr.write("docker compose up failed\n")
            sys.exit(1)
        if not os.environ.get("MOCK_DOCKER_UP_RECREATES"):
            # The project is already running: `up -d` is a no-op on the container, so whatever
            # the configuration was before the call is the configuration after it.
            pass
        else:
            _bump_generation()
        print("[+] Running 2/2\n ✔ Container cir-workbench Started")
        sys.exit(0)
    if "ps" in sys.argv:
        print("NAME            IMAGE           COMMAND                  SERVICE      STATUS      PORTS\ncir-workbench   cir-workbench   \"python3 -m workbenc…\"   workbench    Up 2 hours  0.0.0.0:8000->8000/tcp, 0.0.0.0:5173->5173/tcp")
        sys.exit(0)
    if "stop" in sys.argv or "down" in sys.argv:
        print("Container cir-workbench Stopped")
        sys.exit(0)
    if "exec" in sys.argv or "run" in sys.argv:
        if "pipeline.py" in args_str and "setup" in args_str:
            if os.environ.get("MOCK_PIPELINE_SETUP_FAIL") == "1":
                sys.stderr.write("Pipeline setup failed\n")
                sys.exit(1)
            print("Pipeline setup complete: limn prepared")
            sys.exit(0)
        if "probe_gpu_capability" in args_str or "nvidia_smi" in args_str or "torch" in args_str:
            if os.environ.get("MOCK_PROBE_FAIL") == "1":
                print('{"error": "probe failed"}')
                sys.exit(1)
            if os.environ.get("MOCK_DOCKER_NO_NVIDIA") == "1":
                print('{"nvidia_smi": "NVIDIA RTX 5070 Ti, 12.0", "torch_cuda": false, "cuda_tensor": false, "error": "torch: CUDA unavailable"}')
                sys.exit(1)
            else:
                print('{"nvidia_smi": "NVIDIA GeForce RTX 5070 Ti, 12.0", "torch_cuda": true, "cuda_tensor": true, "compute_capability": "12.0", "device_name": "NVIDIA GeForce RTX 5070 Ti", "error": null}')
                sys.exit(0)
        sys.exit(0)

if "info" in sys.argv:
    if any("Runtimes" in a for a in sys.argv):
        if os.environ.get("MOCK_DOCKER_NO_NVIDIA") == "1":
            print('{"runc": {"path": "runc"}}')
        else:
            print('{"nvidia": {"path": "nvidia-container-runtime"}, "runc": {"path": "runc"}}')
        sys.exit(0)
    else:
        if os.environ.get("MOCK_DOCKER_NO_NVIDIA") == "1":
            print("Runtimes: runc\nDefault Runtime: runc")
        else:
            print("Runtimes: runc nvidia\nDefault Runtime: runc\nnvidia-container-runtime")
        sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == "inspect":
    # `.Mounts` and `.HostConfig.DeviceRequests` are read by the launcher to decide whether a
    # running container may be reused; without an answer here the mount-provenance check could
    # never be exercised by the harness.
    if "cir.commit" in args_str:
        # The launcher asks a running container which COMMIT it was built from, because a container
        # reused on a configuration match can still be the previous checkout's code -- and then a
        # report naming the new commit would be signed by the old one. The default is the harness's
        # own git shim value, so "same checkout" is the default state and a test changes it to
        # express a stale image.
        label = os.environ.get("MOCK_IMAGE_COMMIT", "0123456789abcdef0123456789abcdef01234567")
        if _generation() > 0 and os.environ.get("MOCK_IMAGE_COMMIT_REFRESHED") is not None:
            label = os.environ["MOCK_IMAGE_COMMIT_REFRESHED"]
        print(label)
        sys.exit(0)
    mounts = os.environ.get("MOCK_DOCKER_MOUNTS")
    # The label probe is matched FIRST: the launcher's other inspect templates also contain the
    # literal `Mounts` (the mount list), so a looser test would answer the commit question with a
    # mount list. `cir.commit` appears only in the commit probe.
    if "cir.commit" in args_str:
        print(_label())
        sys.exit(0)
    if "Mounts" in args_str:
        if mounts is None:
            sys.exit(1)
        if _generation() > 0 and os.environ.get("MOCK_DOCKER_MOUNTS_REFRESHED") is not None:
            mounts = os.environ["MOCK_DOCKER_MOUNTS_REFRESHED"]
        print(mounts)
        sys.exit(0)
    # The label probe must be matched BEFORE the mounts probe: its template also contains the
    # literal `Mounts`, so a looser test would answer the moutotquestion with a commit hash.
    if "DeviceRequests" in args_str:
        if os.environ.get("MOCK_DOCKER_NO_NVIDIA") == "1":
            print("[]")
        else:
            print('[{"Driver":"nvidia","Count":0,"DeviceIDs":null,"Capabilities":[["gpu"]],"Options":{}}]')
        sys.exit(0)
    if "Config.Env" in args_str:
        adaptation = os.environ.get("MOCK_CONTAINER_ADAPTATION", "sm_120")
        if _generation() > 0 and os.environ.get("MOCK_CONTAINER_ADAPTATION_REFRESHED") is not None:
            adaptation = os.environ["MOCK_CONTAINER_ADAPTATION_REFRESHED"]
        print(f"WORKBENCH_RUNTIME_ADAPTATION={adaptation}")
        sys.exit(0)
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == "ps":
    if "--filter" in sys.argv:
        print("cir-workbench-1")
    else:
        print("CONTAINER ID   IMAGE           COMMAND                  CREATED        STATUS        PORTS     NAMES\n123456789abc   cir-workbench   \"python3 -m workbenc…\"   2 hours ago    Up 2 hours              cir-workbench")
    sys.exit(0)

def _reject_unknown_exec_flags():
    """Reject flags the real `docker exec` does not accept.

    The earlier fixture ignored every flag, so `docker exec -T ...` -- which the real CLI refuses
    with `unknown shorthand flag: 'T'` and exit 125 -- exited 0 here and the defect was invisible.
    This mirrors the real parser narrowly: `exec` accepts the flags listed below and nothing else.
    `-T` is the interesting case, because `docker compose exec` DOES accept it; a direct
    `docker exec -T` is the mistake this guards.
    """
    takes_value = {"-e", "--env", "--env-file", "-u", "--user", "-w", "--workdir", "--detach-keys"}
    boolean = {"-d", "--detach", "-i", "--interactive", "-t", "--tty", "--privileged"}
    argv = sys.argv[2:]
    index = 0
    while index < len(argv):
        arg = argv[index]
        if not arg.startswith("-"):
            # The container name ends the flag region.
            return
        if "=" in arg and arg.startswith("--"):
            flag = arg.split("=", 1)[0]
            if flag in takes_value:
                index += 1
                continue
            sys.stderr.write(f"unknown flag: {flag}\n")
            sys.exit(125)
        if arg in takes_value:
            index += 2
            continue
        if arg in boolean:
            index += 1
            continue
        if arg.startswith("--"):
            sys.stderr.write(f"unknown flag: {arg}\n")
            sys.exit(125)
        # A cluster of short flags, e.g. `-it`.
        for char in arg[1:]:
            if f"-{char}" not in boolean and f"-{char}" not in takes_value:
                sys.stderr.write(f"unknown shorthand flag: '{char}' in {arg}\n")
                sys.exit(125)
        index += 1

if len(sys.argv) > 1 and sys.argv[1] == "exec":
    _reject_unknown_exec_flags()
    if "test -d" in args_str:
        sys.exit(0)
    if "probe_gpu_capability" in args_str or "nvidia_smi" in args_str or "torch" in args_str:
        if os.environ.get("MOCK_PROBE_FAIL") == "1":
            print('{"error": "probe failed"}')
            sys.exit(1)
        if os.environ.get("MOCK_DOCKER_NO_NVIDIA") == "1":
            print('{"nvidia_smi": "NVIDIA RTX 5070 Ti, 12.0", "torch_cuda": false, "cuda_tensor": false, "error": "torch: CUDA unavailable"}')
            sys.exit(1)
        else:
            print('{"nvidia_smi": "NVIDIA GeForce RTX 5070 Ti, 12.0", "torch_cuda": true, "cuda_tensor": true, "compute_capability": "12.0", "device_name": "NVIDIA GeForce RTX 5070 Ti", "error": null}')
            sys.exit(0)
    if "pipeline.py" in args_str and "setup" in args_str:
        if os.environ.get("MOCK_PIPELINE_SETUP_FAIL") == "1":
            sys.stderr.write("Pipeline setup failed\n")
            sys.exit(1)
        print("Pipeline setup complete: limn prepared")
        sys.exit(0)
    sys.exit(0)

sys.exit(0)
