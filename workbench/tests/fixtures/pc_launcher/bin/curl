#!/usr/bin/env python3
import sys
import os
import json
from pathlib import Path

log_file = os.environ.get("MOCK_LOG_FILE")
if log_file:
    try:
        secrets = {
            k: v for k, v in os.environ.items()
            if any(p in k for p in ("TOKEN", "KEY", "SECRET", "LEDGER"))
        }
        with open(log_file, "a") as f:
            f.write(json.dumps({"tool": "curl", "args": sys.argv[1:], "secrets": secrets}) + "\n")
    except Exception:
        pass

args_str = " ".join(sys.argv)
has_w = "-w" in sys.argv or "--write-out" in args_str
is_devnull = "-o /dev/null" in args_str or ("-o" in sys.argv and "/dev/null" in sys.argv)

if os.environ.get("MOCK_CURL_ALWAYS_FAIL") == "1":
    if has_w:
        print("000")
    sys.stderr.write("curl: (7) Failed to connect to 127.0.0.1 port 8000: Connection refused\n")
    sys.exit(7)

# A container that is running while its API does not answer is exactly the state in which the
# launcher must still refuse to replace it if a job is in flight. Only the API endpoints fail;
# everything else keeps working, so the launcher's other decisions stay testable.
if os.environ.get("MOCK_API_DOWN") == "1" and "/api/" in args_str:
    if has_w:
        print("000")
    sys.stderr.write("curl: (7) Failed to connect to 127.0.0.1 port 8000: Connection refused\n")
    sys.exit(7)

# The *jobs list read* can fail while every other endpoint answers. That is the state the
# launcher's fail-closed branch is written for: "no active job" must never be inferred from an
# unreadable list. `MOCK_CURL_RETRY_COUNT_FILE` fails whole calls instead, so it cannot express
# "this one endpoint is unreadable" without also breaking the calls that must succeed.
if os.environ.get("MOCK_JOBS_LIST_UNREADABLE") == "1":
    target = ""
    for arg in sys.argv[1:]:
        if arg.startswith("http://") or arg.startswith("https://"):
            target = arg
            break
    is_post = "-X" in sys.argv and "POST" in sys.argv[sys.argv.index("-X") + 1:]
    # Only the call that READS THE BODY fails: the status-only probe (`-o /dev/null`) still
    # answers 200, which is exactly the state where the container is up and reachable while the
    # job list itself cannot be read. Failing both calls would take the API-down branch instead
    # and never exercise the job-list decision.
    if target.endswith("/api/jobs") and not is_post and "-d" not in sys.argv and not is_devnull:
        sys.stderr.write("curl: (7) Failed to connect to 127.0.0.1 port 8000: Connection refused\n")
        sys.exit(7)

retry_file = os.environ.get("MOCK_CURL_RETRY_COUNT_FILE")
if retry_file and os.path.exists(retry_file):
    try:
        count = int(Path(retry_file).read_text().strip())
        if count > 0:
            Path(retry_file).write_text(str(count - 1))
            if has_w:
                print("000")
            sys.stderr.write("curl: (7) Failed to connect to 127.0.0.1 port 8000: Connection refused\n")
            sys.exit(7)
    except Exception:
        pass

url = ""
for arg in sys.argv[1:]:
    if arg.startswith("http://") or arg.startswith("https://"):
        url = arg
        break

if not url:
    for arg in reversed(sys.argv[1:]):
        if not arg.startswith("-"):
            url = arg
            break

body = ""
status_code = "200"

# The recorded API surface, served from a directory when `MOCK_API_STATE` names one.
#
# The environments below express ONE endpoint at a time, which cannot describe a deployment that
# holds both artifact families at once -- a per-query run in the DuckDB index and an aggregate-only
# run beside it. The launcher's index gate has to consult both endpoints together, so the fixtures
# for those tests are files: `runs.json` and `benchmark-runs.json`, generated from the real
# producers and served verbatim. A recorded body cannot drift from the schema the way a
# hand-written `json.dumps` in this shim can.
_api_state = os.environ.get("MOCK_API_STATE")
if _api_state:
    _state_dir = Path(_api_state)
    for _endpoint, _filename in (("/api/benchmark-runs", "benchmark-runs.json"),
                                 ("/api/runs", "runs.json")):
        if _endpoint in url and not url.endswith("/api/runs/gate"):
            _file = _state_dir / _filename
            if not _file.exists():
                sys.stderr.write("curl: mock state has no %s\n" % _filename)
                sys.exit(7)
            body = _file.read_text()
            if has_w:
                print(f"{body}\n{status_code}")
            else:
                print(body)
            sys.exit(0)

if "/api/models" in url:
    fixtures_dir = Path(__file__).resolve().parent.parent
    models_file = fixtures_dir / "models.json"
    if models_file.exists():
        body = models_file.read_text().strip()
    else:
        body = "[]"
    # `MOCK_MODELS_MISSING_MEMBER=<checkpoint_id>` marks one bundle member unavailable in the
    # availability view, which is the state the real registry reports while a member has not been
    # downloaded yet: `checkpoint_downloaded` false and `runnable` false, with the reason named.
    # Exactly the fields `checkpoint_availability` produces are set -- an invented field here
    # would let the launcher pass this fixture while disagreeing with the real API.
    missing_member = os.environ.get("MOCK_MODELS_MISSING_MEMBER")
    if missing_member:
        models = json.loads(body)
        for model in models:
            for bundle in model.get("checkpoint_bundles") or []:
                for member in bundle.get("members") or []:
                    if member.get("checkpoint_id") == missing_member:
                        member["runnable"] = False
                        member["checkpoint_downloaded"] = False
                        member["blocking_reasons"] = ["checkpoint missing: " + missing_member]
            for item in model.get("checkpoints") or []:
                if item.get("checkpoint_id") == missing_member:
                    item["runnable"] = False
                    item["checkpoint_downloaded"] = False
                    item["blocking_reasons"] = ["checkpoint missing: " + missing_member]
        body = json.dumps(models)
    # `MOCK_MODELS_UNRUNNABLE_MEMBER=<checkpoint_id>` is the OTHER real blocking state: the
    # weights are present but the member is not runnable (a missing adapted runtime, an
    # unverified mapping). It must refuse too.
    unrunnable_member = os.environ.get("MOCK_MODELS_UNRUNNABLE_MEMBER")
    if unrunnable_member:
        models = json.loads(body)
        for model in models:
            for bundle in model.get("checkpoint_bundles") or []:
                for member in bundle.get("members") or []:
                    if member.get("checkpoint_id") == unrunnable_member:
                        member["runnable"] = False
                        member["checkpoint_downloaded"] = True
                        member["blocking_reasons"] = ["runtime not ready: " + unrunnable_member]
            for item in model.get("checkpoints") or []:
                if item.get("checkpoint_id") == unrunnable_member:
                    item["runnable"] = False
                    item["checkpoint_downloaded"] = True
                    item["blocking_reasons"] = ["runtime not ready: " + unrunnable_member]
        body = json.dumps(models)
elif url.endswith("/api/jobs") or url.endswith("/api/jobs/"):
    is_post = "-X" in sys.argv and ("POST" in sys.argv[sys.argv.index("-X") + 1:] or "POST" in args_str)
    if is_post or "-d" in sys.argv or "--data" in args_str:
        post_log = os.environ.get("MOCK_POST_JOBS_FILE")
        if post_log:
            try:
                with open(post_log, "a") as f:
                    f.write(json.dumps({"args": sys.argv[1:]}) + "\n")
            except Exception:
                pass
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "queued"
        })
        status_code = "201"
    else:
        # GET /api/jobs
        job_status = os.environ.get("MOCK_JOB_STATUS", "")
        # The list is read several times before a decision is made: the already-running probe,
        # the readiness poll, then the duplicate-job check. `MOCK_QUEUED_READS` is how many of
        # those reads still see the pre-existing job as `queued` before it settles to a terminal
        # state — so a test can put the observable transition exactly where the real backend
        # would put it (after acceptance / after the worker picks it up) instead of coupling
        # fixture state to an incidental poll count.
        reads_file = Path(os.environ.get("MOCK_READS_FILE") or (os.environ.get("MOCK_COUNTER_FILE")
                                                               or "/tmp/mock_jobs_get_count.txt"))
        reads = 0
        if reads_file.exists():
            try:
                reads = int(reads_file.read_text().strip())
            except (OSError, ValueError):
                reads = 0
        try:
            reads_file.write_text(str(reads + 1))
        except OSError:
            pass
        still_queued_for = int(os.environ.get("MOCK_QUEUED_READS", "0") or "0")

        post_log = Path(os.environ.get("MOCK_POST_JOBS_FILE", "/tmp/mock_jobs_post.log"))
        accepted = 0
        if post_log.exists():
            try:
                accepted = len([line for line in post_log.read_text().splitlines() if line.strip()])
            except OSError:
                accepted = 0

        if job_status == "queued":
            cur_st = "queued" if (accepted == 0 and reads < still_queued_for) else "completed"
            body = json.dumps([{
                "job_id": "job_limn_queued_01",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": cur_st,
                "return_code": 0,
                "provenance": {"run_id": "run_limn_corr_01"}
            }])
        elif job_status == "running":
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "running"
            }])
        elif job_status == "completed":
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "completed",
                "return_code": 0,
                "provenance": {"run_id": "run_limn_corr_01"}
            }])
        elif job_status == "completed_no_run_id":
            # A terminal job whose OWN record names no execution identity. The launcher must refuse
            # rather than search for a report that merely shares its model/checkpoint/protocol.
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "completed",
                "return_code": 0,
                "provenance": {}
            }])
        elif job_status == "failed":
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "failed",
                "stage": "evaluation",
                "error": "CUDA out of memory",
                "log_directory": "/artifacts/logs/job_limn_failed_01"
            }])
        elif job_status == "blocked":
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "blocked",
                "stage": "gpu_verification",
                "error": "GPU capability unverified",
                "log_directory": "/artifacts/logs/job_limn_blocked_01"
            }])
        else:
            body = json.dumps([{
                "job_id": "job_limn_new_999",
                "model_id": "limn",
                "checkpoint_id": "base_iter0_all_categories",
                "protocol_id": "fashioniq_val_split",
                "status": "completed",
                "return_code": 0,
                "provenance": {"run_id": "run_limn_corr_01"}
            }])
elif "/api/jobs/" in url:
    job_status = os.environ.get("MOCK_JOB_STATUS", "completed")
    if job_status == "failed":
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "failed",
            "stage": "evaluation",
            "error": "CUDA out of memory",
            "log_directory": "/artifacts/logs/job_limn_failed_01"
        })
    elif job_status == "blocked":
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "blocked",
            "stage": "gpu_verification",
            "error": "GPU capability unverified",
            "log_directory": "/artifacts/logs/job_limn_blocked_01"
        })
    elif job_status == "running":
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "running"
        })
    elif job_status == "queued":
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "queued"
        })
    elif job_status == "completed_no_run_id":
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "completed",
            "return_code": 0,
            "provenance": {}
        })
    else:
        body = json.dumps({
            "job_id": "job_limn_new_999",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "status": "completed",
            "return_code": 0,
            "provenance": {"run_id": "run_limn_corr_01"}
        })
elif "/api/runs" in url:
    # The index-facing view. `MOCK_INDEX_RUNS` expresses the states the launcher's index gate must
    # DISTINGUISH: a run indexed under another identity, one indexed without an evidence state, and
    # ones indexed with one. `evidence_status` is what the real `/api/runs` serves (storage.list_runs
    # merges it from the DuckDB column), so a fixture without it is the state the gate refuses.
    if os.environ.get("MOCK_INDEX_RUNS"):
        variant = os.environ["MOCK_INDEX_RUNS"]
        row = {
            "run_id": {"wrong_run": "run_limn_OTHER_99"}.get(variant, "run_limn_corr_01"),
            "model_id": {"wrong_model": "dcnet"}.get(variant, "limn"),
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "created_at": "2026-10-16T00:00:00Z",
        }
        if variant != "no_state":
            row["evidence_status"] = {
                "unverified": "PER_QUERY_UNVERIFIED",
            }.get(variant, "PER_QUERY_VERIFIED")
        body = json.dumps([row])
    elif os.environ.get("MOCK_RUNS_STATUS") == "corroborated":
        # The per-query column AFTER the reader promoted it. Two facts pin this value:
        #   * the run's own report says EXPORTED, never VERIFIED (only the verifier promotes, and
        #     the promotion lives in the launcher's reader, from the receipt that binds the
        #     artifact digest); and
        #   * `pc.sh` cross-checks the reader's conclusion against this column in BOTH directions.
        # So a coherent deployment that has just been verified serves VERIFIED here while the file
        # still says EXPORTED. Serving EXPORTED here instead describes a deployment where the
        # promotion never happened, which the launcher refuses by design.
        body = json.dumps([{
            "run_id": "run_limn_corr_01",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "evidence_status": "PER_QUERY_VERIFIED",
            "corroborated": True,
            "official": True,
            "created_at": "2026-10-16T00:00:00Z"
        }])
    elif os.environ.get("MOCK_RUNS_STATUS") == "corroborated_no_proof":
        # A real deployment whose completion proof is gone: the run stays in the index, because a
        # run that happened is still a run that happened, while the aggregate view reports the
        # proof-unavailable policy. Both halves are served so the launcher sees the state it is
        # written for instead of an uncorroborated one it would reject.
        body = json.dumps([{
            "run_id": "run_limn_corr_01",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "evidence_status": "PER_QUERY_EXPORTED_UNVERIFIED",
            "created_at": "2026-10-16T00:00:00Z"
        }])
    else:
        body = "[]"
elif "/api/benchmark-runs" in url:
    if os.environ.get("MOCK_RUNS_STATUS") == "corroborated_no_proof":
        # The receipt the API serves for this state, with the two fields the launcher's reuse
        # check reads to distinguish "the proof is gone, so full verification cannot run but the
        # invocation IS authenticated" from "this run was never corroborated".
        body = json.dumps([{
            "run_id": "run_limn_corr_01",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "execution_status": "EXECUTION_COMPLETED",
            # The model's own declaration, as the report always carries it: the registry says LIMN
            # has an observer, so a run of LIMN whose report omitted the field would be a report
            # disagreeing with the registry -- which the gate refuses, correctly. With the proof
            # gone, the artifact can never be promoted, so the state the producer itself would have
            # written is the exported-but-unverified one.
            "per_query_capability": "LIMN_QUERY_OBSERVER_V1",
            "per_query_state": "PER_QUERY_EXPORTED_UNVERIFIED",
            "verification": {
                "certified": False,
                "is_research_evidence": False,
                "execution_authenticated": True,
                "state": "proof_unavailable",
                "certification_mode": "proof_unavailable",
                # The receipt still names the bytes it was derived from: the proof is what is missing,
                # not the report, and the launcher refuses a receipt that names nothing because then
                # the report's own fields are tied to no certified file.
                "report_digest": "0" * 64,
                "reasons": [],
                "evidence_reasons": ["declared output missing: completion proof"],
            },
            "created_at": "2026-10-16T00:00:00Z"
        }])
    elif os.environ.get("MOCK_RUNS_STATUS") == "corroborated":
        # The launcher reads its index gate from THIS endpoint as well as /api/runs. A fixture
        # that serves the run here but omits the verifier's receipt describes a report the API
        # refused to certify, so the gate would (correctly) refuse it -- and the test would be
        # asserting against a state the real API cannot produce. The receipt and its two claims
        # are therefore part of the fixture.
        body = json.dumps([{
            "run_id": "run_limn_corr_01",
            "model_id": "limn",
            "checkpoint_id": "base_iter0_all_categories",
            "protocol_id": "fashioniq_val_split",
            "per_query_capability": "LIMN_QUERY_OBSERVER_V1",
            "per_query_state": "PER_QUERY_VERIFIED",
            "benchmark_gate": {"status": "PASS_WITHIN_5_PERCENT"},
            "verification": {"certified": True, "is_research_evidence": True,
                             "state": "certified", "report_digest": "fixture"},
            "created_at": "2026-10-16T00:00:00Z"
        }])
    else:
        body = "[]"
elif "/api/index/rebuild" in url:
    # The rebuild is the step whose failure the launcher used to swallow. `MOCK_INDEX_REBUILD`
    # reproduces each real failure shape: a 5xx from the endpoint, and a response that is not the
    # shape a rebuild answers with.
    variant = os.environ.get("MOCK_INDEX_REBUILD", "")
    if variant == "http_500":
        body = json.dumps({"detail": "duckdb: IO Error: could not open database"})
        status_code = "500"
    elif variant == "malformed":
        body = "{not json"
    else:
        body = json.dumps({"runs_indexed": 1})
elif ":5173" in url:
    body = "<!doctype html><html><head><title>CIR Workbench</title></head><body>OK</body></html>"
else:
    body = "{}"

if is_devnull:
    if has_w:
        print(status_code)
elif has_w:
    if body:
        print(f"{body}\n{status_code}")
    else:
        print(status_code)
else:
    if body:
        print(body)

sys.exit(0)
