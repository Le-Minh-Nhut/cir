# Optional local overrides in workbench/config/workbench.env. Process environment wins; do not source
# this file as shell code. Relative paths resolve against CIR_REPO_ROOT.
CIR_REPO_ROOT=
CIR_DATA_ROOT=data
FASHIONIQ_ROOT=data/FashionIQ
WORKBENCH_HOST=127.0.0.1
WORKBENCH_BACKEND_PORT=8000
WORKBENCH_FRONTEND_PORT=5173
WORKBENCH_ARTIFACTS_ROOT=workbench/artifacts
WORKBENCH_CHECKPOINT_ROOT=workbench/artifacts/checkpoints
WORKBENCH_RESULTS_ROOT=workbench/artifacts/results
WORKBENCH_THIRD_PARTY_ROOT=workbench/third_party

# External asset locations: set only after verifying provenance and local file checksum.
WORKBENCH_CLVC_RESNET50_WEIGHTS=
WORKBENCH_DCNET_RESNET50_WEIGHTS=
WORKBENCH_CLIP4CIR_RN50X4_WEIGHTS=
WORKBENCH_TGCIR_VITB16_WEIGHTS=
WORKBENCH_SPRC_BLIP2_WEIGHTS=

# Hugging Face cache root for assets declared with HF_HOME (for example TME's tokenizer).
# Relative to the repo root; overrides the default ~/.cache/huggingface cache root.
HF_HOME=
# Dedicated model interpreters. Empty means use a RUNTIME_VERIFIED assignment when available.
WORKBENCH_CSMCIR_PYTHON=
WORKBENCH_AIRKNOW_PYTHON=
WORKBENCH_CONESEP_PYTHON=
WORKBENCH_HABIT_PYTHON=
WORKBENCH_INTENT_PYTHON=
WORKBENCH_HINT_PYTHON=
WORKBENCH_ENCODER_PYTHON=
WORKBENCH_PAIR_PYTHON=
WORKBENCH_CLVC_PYTHON=
WORKBENCH_DCNET_PYTHON=
WORKBENCH_CLIP4CIR_PYTHON=
WORKBENCH_TGCIR_PYTHON=
WORKBENCH_SPRC_PYTHON=
WORKBENCH_LIMN_PYTHON=
WORKBENCH_TME_PYTHON=
WORKBENCH_PTHA_MTST_PYTHON=
