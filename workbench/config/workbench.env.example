# Optional local overrides. Copy to workbench.env; environment variables win.
# Paths may be absolute or relative to CIR_REPO_ROOT.
CIR_REPO_ROOT=
CIR_DATA_ROOT=data
FASHIONIQ_ROOT=data/FashionIQ
WORKBENCH_HOST=127.0.0.1
WORKBENCH_BACKEND_PORT=8000
WORKBENCH_FRONTEND_PORT=5173
WORKBENCH_CHECKPOINT_ROOT=workbench/artifacts/checkpoints
WORKBENCH_RESULTS_ROOT=workbench/artifacts/results
WORKBENCH_THIRD_PARTY_ROOT=workbench/third_party
# External model assets: export only after verifying source and local file checksum.
WORKBENCH_CLVC_RESNET50_WEIGHTS=
WORKBENCH_DCNET_RESNET50_WEIGHTS=
WORKBENCH_CLIP4CIR_RN50X4_WEIGHTS=
WORKBENCH_TGCIR_VITB16_WEIGHTS=
WORKBENCH_SPRC_BLIP2_WEIGHTS=
