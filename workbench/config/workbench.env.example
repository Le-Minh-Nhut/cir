# Example checkout defaults below are NOT PC roots. For a PC run, set CIR_REPO_ROOT to the actual
# checkout and each of five YAML-to-env root mappings to the matching absolute path.
# Process environment wins; do not source workbench.env as shell code. Relative paths resolve against
# CIR_REPO_ROOT but are not suitable for synchronizing custom PC roots.
CIR_REPO_ROOT=
CIR_DATA_ROOT=data
FASHIONIQ_ROOT=data/FashionIQ
WORKBENCH_HOST=127.0.0.1
WORKBENCH_BACKEND_PORT=8000
WORKBENCH_FRONTEND_PORT=5173
WORKBENCH_ARTIFACTS_ROOT=workbench/artifacts
WORKBENCH_CHECKPOINT_ROOT=workbench/artifacts/checkpoints
WORKBENCH_RESULTS_ROOT=workbench/artifacts/results
WORKBENCH_THIRD_PARTY_ROOT=workbench/third_party

# External asset locations: set only after verifying provenance and local file checksum.
WORKBENCH_CLVC_RESNET50_WEIGHTS=
WORKBENCH_DCNET_RESNET50_WEIGHTS=
WORKBENCH_CLIP4CIR_RN50X4_WEIGHTS=
WORKBENCH_TGCIR_VITB16_WEIGHTS=
WORKBENCH_SPRC_BLIP2_WEIGHTS=

# Hugging Face cache root for assets declared with HF_HOME (for example TME's tokenizer).
# Relative to the repo root; overrides the default ~/.cache/huggingface cache root.
HF_HOME=
# Dedicated model interpreters. Empty means use a RUNTIME_VERIFIED assignment when available.
WORKBENCH_CSMCIR_PYTHON=
WORKBENCH_AIRKNOW_PYTHON=
WORKBENCH_CONESEP_PYTHON=
WORKBENCH_HABIT_PYTHON=
WORKBENCH_INTENT_PYTHON=
WORKBENCH_HINT_PYTHON=
WORKBENCH_ENCODER_PYTHON=
WORKBENCH_PAIR_PYTHON=
WORKBENCH_CLVC_PYTHON=
WORKBENCH_DCNET_PYTHON=
WORKBENCH_CLIP4CIR_PYTHON=
WORKBENCH_TGCIR_PYTHON=
WORKBENCH_SPRC_PYTHON=
WORKBENCH_LIMN_PYTHON=
WORKBENCH_TME_PYTHON=
WORKBENCH_PTHA_MTST_PYTHON=

# Operator-selected runtime adaptation. Set it to the `target_compute_capability` a model declares
# under `adapted_runtime` (e.g. `sm_120`, for Blackwell / RTX 50-series) to provision WITHOUT changing
# any preprocessing or evaluation semantics. Current active sm_120 profiles pin torch 2.7.1 /
# torchvision 0.22.1 from cu128. Models with no matching profile keep their historical
# author pins exactly as declared; a value no model declares is refused rather than silently ignored.
WORKBENCH_RUNTIME_ADAPTATION=

# Operational batch for TME's CUDA-only validation-feature generator. `batch_size` decides only how
# many gallery images share one forward pass, never what the features mean. The pinned default is 512,
# which OOMs on consumer cards (measured: 512 OOMs on a 4096 MiB device, 72 completes); set it to what
# the local card sustains. The resolved value is bound into the precompute receipt and compared on
# reuse, so a cache is never reused under a different batch than produced it.
WORKBENCH_TME_BATCH_SIZE=
