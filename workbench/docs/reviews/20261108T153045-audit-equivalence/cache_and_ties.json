{
 "cache_identity": {
  "identity_has_scoring_module_source_hash": false,
  "identity_source_hash_fields": [
   "adapter_module_source_hash",
   "adapter_module_source_status",
   "condition_transform_source_hash",
   "condition_transform_source_status"
  ],
  "inputs": [
   {
    "in_identity": true,
    "input": "gallery ordered identities",
    "note": "fingerprint of protocol id + ordered gallery + candidate names",
    "recorded_at": "identity.gallery_identity"
   },
   {
    "in_identity": true,
    "input": "gallery file content",
    "note": "sha256 per resolved file, rolled up",
    "recorded_at": "identity.gallery_image_identity.content_digest"
   },
   {
    "in_identity": true,
    "input": "query ordered identities",
    "note": "",
    "recorded_at": "identity.query_order_identity"
   },
   {
    "in_identity": true,
    "input": "query reference file content",
    "note": "",
    "recorded_at": "identity.query_image_identity.content_digest"
   },
   {
    "in_identity": true,
    "input": "condition set",
    "note": "changes which query matrices are produced",
    "recorded_at": "identity.conditions"
   },
   {
    "in_identity": true,
    "input": "ablation policy (black image / empty text)",
    "note": "hashes workbench/composition/inputs.py",
    "recorded_at": "identity.condition_transform_source_hash"
   },
   {
    "in_identity": true,
    "input": "adapter module source",
    "note": "",
    "recorded_at": "identity.adapter_module_source_hash"
   },
   {
    "in_identity": true,
    "input": "adapter method source",
    "note": "encode_queries/encode_targets/score/rank/mode_supported",
    "recorded_at": "identity.adapter_source_hashes"
   },
   {
    "in_identity": false,
    "input": "shared decode + scoring helpers",
    "note": "ABSENT from run 497c25c57fbeba885ecfb9d1: the field was added after this run was written. Present in later identities, but hashes only workbench/composition/adapters.py",
    "recorded_at": "identity.scoring_module_source_hash"
   },
   {
    "in_identity": true,
    "input": "model checkpoint bytes",
    "note": "",
    "recorded_at": "identity.checkpoint_identity"
   },
   {
    "in_identity": true,
    "input": "model interpreter path + env fingerprint",
    "note": "",
    "recorded_at": "identity.runtime_identity"
   },
   {
    "in_identity": true,
    "input": "torch / torchvision / numpy versions",
    "note": "indirect: a fingerprint of the environment record, not of the imported module versions",
    "recorded_at": "identity.runtime_identity.environment_fingerprint"
   },
   {
    "in_identity": false,
    "input": "BLAS / OMP intra-op thread count",
    "note": "NOT recorded by name. Measured to change FAST-PATH score bits (ein_threads.txt: maxdelta 2.384e-07 at 10 threads vs 3.576e-07 elsewhere), so it can change a score-derived rank. The shipped `old` einsum was bit-identical across 1..10 threads, so today it does not move the cached MATRIX, but it does move a fast-path score.",
    "recorded_at": "(none)"
   },
   {
    "in_identity": true,
    "input": "GPU model",
    "note": "device NAME only",
    "recorded_at": "identity.gpu_identity"
   },
   {
    "in_identity": false,
    "input": "GPU compute capability / driver / CUDA version",
    "note": "the device capability that decides kernel selection is not a named field; only the name is",
    "recorded_at": "identity.runtime_identity (partial)"
   },
   {
    "in_identity": false,
    "input": "tf32 / cudnn benchmark / deterministic flags",
    "note": "NOT recorded; can change GPU forward bits",
    "recorded_at": "(none)"
   },
   {
    "in_identity": true,
    "input": "batch size for the FORWARD pass",
    "note": "changes run id, so it invalidates the cache",
    "recorded_at": "identity.batch_size, identity.adapter_batch_size"
   },
   {
    "in_identity": false,
    "input": "decode worker count",
    "note": "deliberately NOT in the identity because decode is bit-identical; measured, and re-measured in this audit across 2/4/8 workers for two transform families",
    "recorded_at": "identity (absent)"
   },
   {
    "in_identity": true,
    "input": "transform implementation used per model",
    "note": "a LABEL from the registry, not the transform's source",
    "recorded_at": "identity.preprocessing.registry_values.transform"
   },
   {
    "in_identity": false,
    "input": "the transform's actual code/parameters",
    "note": "recorded as a registry LABEL; the code that performs it is covered only by the adapter module hash, so a change inside a third-party transform function is not detected",
    "recorded_at": "identity.preprocessing.registry_values.image_size"
   },
   {
    "in_identity": true,
    "input": "feature dtype",
    "note": "cached, but not compared on load",
    "recorded_at": "sidecar `dtype`"
   },
   {
    "in_identity": false,
    "input": "feature array CONTENT",
    "note": "the sidecar holds a fingerprint of the IDENTITY, not of the array bytes; nothing verifies the stored numbers",
    "recorded_at": "(none)"
   }
  ],
  "inputs_not_in_identity": [
   "shared decode + scoring helpers",
   "BLAS / OMP intra-op thread count",
   "GPU compute capability / driver / CUDA version",
   "tf32 / cudnn benchmark / deterministic flags",
   "decode worker count",
   "the transform's actual code/parameters",
   "feature array CONTENT"
  ],
  "run": "497c25c57fbeba885ecfb9d1",
  "sidecar_fields": [
