@@ -788,6 +788,30 @@
     }
 
 
+def _seed_generators(seed: int) -> None:
+    """Make the global generators deterministic for this run, then stop seeding.
+
+    Scope is deliberate: only the composition run's own draws. Callers that seeded deliberately
+    before calling `run_composition` are overwritten, because `seed` is a declared identity field
+    and a declared field that does not control its variable is worse than no field at all.
+    """
+    import random
+
+    random.seed(seed)
+    try:
+        import numpy as _np
+
+        _np.random.seed(seed)
+    except Exception:  # numpy is a hard dependency, but a broken install must not mask the run
+        pass
+    try:
+        import torch as _torch
+
+        _torch.manual_seed(seed)
+    except Exception:  # the controller need not have torch; workers are separate processes
+        pass
+
+
 def run_composition(data: Any, model_specs: Sequence[ModelSpec], config: Any, *,
                     subsets: Sequence[str], batch_size: int = 32, smoke: int | None = None,
                     resume: bool = False, conditions: Sequence[str] = CONDITIONS,
@@ -813,6 +837,12 @@
         raise ValueError("batch_size must be positive")
     if smoke is not None and smoke < 1:
         raise ValueError("smoke query limit must be positive")
+    # `seed` is bound into `identity`, so it MUST actually control the randomness it claims to.
+    # It used to be hashed and then never applied: a changed `--seed` minted a new run_id and
+    # produced byte-identical results, and the RNG state that really produced the features was
+    # unbound. Seed the generators here, in the controller, so controller-side scoring and any
+    # adapter that draws from the global generators see a deterministic state.
+    _seed_generators(seed)
     if not conditions or any(item not in CONDITIONS for item in conditions):
         raise ValueError(f"conditions must be selected from {CONDITIONS}")
     from workbench.composition.topk import normalise_depth, open_export, abort_export, close_export
