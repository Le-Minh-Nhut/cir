                     remaining_scopes: int, query_count: int, condition_count: int) -> tuple[np.memmap, dict[str, int]]:
-    cached = _load_memmap(destination, fingerprint)
+    # The sidecar records the shape this cache was written with; a truncated or partially
+    # overwritten .npy keeps its .json and would otherwise be reused at whatever length it now
+    # has. `_encode_queries` already passes its expected shape here; the gallery path must too.
+    metadata_shape = _memmap_metadata_shape(destination)
+    cached = _load_memmap(destination, fingerprint, metadata_shape)
     if cached is not None:
+        if metadata_shape is not None and cached.shape[0] != len(image_paths):
+            raise ValueError(
