# .git, local venvs, caches and heavy external assets never belong in the image.
.git
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Heavy external assets are mounted at run time, not baked in.
data
workbench/third_party
workbench/artifacts

# Node artifacts (built fresh inside the image).
workbench/frontend/node_modules
workbench/frontend/dist
workbench/frontend/*.tsbuildinfo

# Local secrets and scratch. The negations below keep the checked-in EXAMPLES out of the
# ignore so they ship with the repo — the real .env files (operator secrets, host paths)
# must never enter the image; they are bind-mounted or read by compose at run time.
workbench/config/workbench.env
**/.env
!workbench/config/workbench.env.example
!workbench/docker/.env.example
